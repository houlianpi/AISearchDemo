{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "wa-agent-server",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	"limits": {
		// The agent loop can burn real CPU on long turns (JSON/diff/token estimation).
		// Every inbound WebSocket message resets this budget.
		"cpu_ms": 300000
	},
	"durable_objects": {
		"bindings": [{ "name": "USER_AGENT", "class_name": "UserAgentDO" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserAgentDO"] }],
	// pi's package-location detection runs `fileURLToPath(import.meta.url)` at
	// module scope, which the bundler cannot resolve for a Worker. The value is
	// only used for CLI self-update/doc paths, none of which run here.
	"define": {
		"import.meta.url": "\"file:///worker/index.js\""
	},
	"vars": {
		// Which upstream is live: "gateway", "deepseek", or "copilot". Redeploy to switch.
		"LLM_PROVIDER": "copilot",

		"LLM_BASE_URL": "https://cc.buildnow.work/v1",
		"DEFAULT_MODEL": "claude-opus-4.8",

		"DEEPSEEK_BASE_URL": "https://ds.buildnow.work/v1",
		"DEEPSEEK_DEFAULT_MODEL": "deepseek-v4-flash",

		"COPILOT_BASE_URL": "https://copilot.buildnow.work/v1",
		"COPILOT_DEFAULT_MODEL": "gpt-5.6-sol",

		"MAX_CONCURRENT_TURNS": "3"
	},
	"observability": { "enabled": true }
}
