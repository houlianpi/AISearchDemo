# Any multimodal model available through the local pi installation.
PI_MODEL=github-copilot/gpt-5.6-sol
PORT=8787

# Recommended search provider. Also set provider=tavily in ~/.pi/agent/web-search.json.
TAVILY_API_KEY=tvly-your-key

# Optional recording safety net. Synthetic results are clearly marked in JSON.
DEMO_SEARCH_FALLBACK=false
